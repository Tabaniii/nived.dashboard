NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute staging/production origin used for NFC card links + QR codes.
# Set this in the staging deployment environment; do not leave it on localhost.
NEXT_PUBLIC_APP_URL=https://nived.studio

# Optional legacy notification integrations for configured merchant alert recipients
# WhatsApp via Fonnte: https://md.fonnte.com → Device → Token
FONNTE_TOKEN=
# Telegram bot from @BotFather; username without "@" is shown in the dashboard instructions
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Weekly AI summary via Google Gemini (falls back to rule-based summary when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Protects the scheduled GET /api/cron/weekly-summary and POST /api/reports/weekly-sentiment.
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# Optional — used by scripts/seed-admin.mjs
ADMIN_EMAIL=admin@nived.id
ADMIN_PASSWORD=ChangeMeNow!123
ADMIN_FULL_NAME=Nived Admin
